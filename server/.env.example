# Alive server keys — copy to .env (gitignored) and fill in.
# Nothing here is required for the server to RUN — each key turns a
# source from "honestly unavailable" to live. /health + field.status
# always report which sources are actually feeding the field.

# ── PM2.5 ground truth (the one real gap) ────────────────────────────
# Without a station key the field is CAMS/Open-Meteo model + FIRMS fires
# only — real but *modelled*, and the app says so. One of these upgrades
# it to measured:

# OpenAQ v3 — aggregates CPCB/DPCC instruments; works from any network.
#   Get: https://explore.openaq.org → sign in → account → API Key (free)
OPENAQ_API_KEY=

# WAQI (aqicn.org) — republishes the same CPCB/DPCC instruments; fallback
# for OpenAQ in both the live blend and the 15-min index. Works from any
# network, no region lock.
#   Get: https://aqicn.org/data-platform/token/ (free)
WAQI_API_KEY=

# CPCB direct via data.gov.in OGD API — official "Real time Air Quality
# Index" feed, resource 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69.
#   Get: https://data.gov.in → register → My Account → API Key (free)
#   NOTE: api.data.gov.in only answers India-routable IPs — the key is
#   for the deployed ap-south-1 server, it will NOT work from a foreign
#   box/VPN exit. The adapter ships ready (server/ingest_cpcb.py).
CPCB_API_KEY=

# ── optional upgrades ────────────────────────────────────────────────

# NASA FIRMS map key — upgrades fire detections from the public 24h CSV
# (already live, no key) to the ~3h VIIRS NRT area API.
#   Get: https://firms.modaps.eosdis.nasa.gov/api/area/ → Get MAP_KEY
#   (email signup, instant)
FIRMS_MAP_KEY=

# Delhi OTD — realtime DTC/cluster bus vehicle positions + trip updates
# (GTFS-RT). Only affects the transit layer, not PM2.5.
#   Get: https://otd.delhi.gov.in/data/realtime/ → request form (free,
#   they email the key)
ALIVE_OTD_API_KEY=

# Amazon Location Service v2 — T2 place suggestions (HERE data), traffic-
# aware routes, and Amazon reverse-geocode as a middle tier. OPTIONAL:
# without it the app still works (bundled gazetteer + C++ search, OSRM
# routing, gazetteer-first reverse) and /health reports it disabled.
#   Get: AWS console → Location Service → API keys (metered, set a cap)
ALIVE_LOCATION_KEY=
#ALIVE_LOCATION_REGION=ap-south-1

# DPCC 5-min scrape adapter — opt-in additive station feed on top of the
# model field. Set 1 to enable; unset/0 leaves it dark.
#ALIVE_DPCC_INGEST=0

# ── ops ──────────────────────────────────────────────────────────────

# Routing backend — a self-hosted osrm-routed serves ONE profile and
# ignores the /{profile}/ path segment, so point each mode at the right
# daemon (scripts/geo/ builds them). Default: http://127.0.0.1:5001.
#OSRM_URL=
#OSRM_URL_DRIVING=
#OSRM_URL_CYCLING=
#OSRM_URL_WALKING=
#OSRM_LOCAL_TIMEOUT=  per-request deadline for the local OSRM (seconds)

# Request guardrails (middleware.py — sane defaults, tune only if needed)
#ALIVE_RATE_RPS=10        sustained requests/s per client
#ALIVE_RATE_BURST=30      burst allowance per client
#ALIVE_MAX_BODY_BYTES=    POST/PUT/PATCH body cap (default 2 MiB)
#ALIVE_SEC_HSTS=1         "0" disables the HSTS header (on, https only)

# Bearer token for /admin/api* + admin aggregates. With this UNSET those
# endpoints are loopback-only — safe default, do not open without it.
#   Invent it yourself: openssl rand -hex 32
ALIVE_ADMIN_TOKEN=

# In-app ingest loop (default on): rebuilds the air-index snapshot every
# 15 min so the field stays fresh with zero traffic. Set 0 only when an
# external ingest_worker container writes to the same snapshot dir.
#ALIVE_INGEST_IN_APP=1

# ── deploy-only (never needed locally) ───────────────────────────────
# Set by provision.sh / the ECS task def — do not fill for local dev.
# ALIVE_AIR_BUCKET=        S3 bucket for snapshot archive
# COMMUNITY_BUCKET=        S3 bucket for the public community board feed
# AGG_TABLE / ALIVE_DDB_TABLE=   DynamoDB table for trip aggregates
# AWS_REGION=ap-south-1    plus real AWS creds in the environment/role
# BUILD_SHA / GIT_SHA / ALIVE_VERSION / APP_VERSION=   stamped by deploy.sh

# ── internals (exhaustive; defaults are right for local dev) ─────────
# Data paths & snapshots — ALIVE_CORPUS, ALIVE_GAZETTEER, ALIVE_ALIASES,
#   ALIVE_SNAPSHOT_DIR/KEEP/KEEP_DAYS/PROTECT, AIRFIELD_NO_SNAPSHOT,
#   ALIVE_ARCHIVE(_DIR/_DELAY_S/_KEEP_DAYS), ALIVE_DAILY_DIR,
#   ALIVE_VALID_DIR, ALIVE_VALIDATION_WEEK
# Scheduled jobs — ALIVE_JOB, ALIVE_ROLLUP_IN_APP, ALIVE_ROLLUP_DATE,
#   ALIVE_ROLLUP_MIRROR, ALIVE_GC_APPLY, GTFS_BAKE_TIMEOUT_S
# Misc — ALIVE_SKILL_TTL_S (forecast-skill cache), LIVE, SOURCE_*
