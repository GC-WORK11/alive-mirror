# ALive-108 API — container image for ECS Fargate (also App Runner / local).
#
# Build context is `server/` — scripts/deploy.sh runs
# `docker build "$ROOT/server"` and CodeBuild receives
# `git archive HEAD:server` (buildspec.yml must stay at the zip root).
# Do NOT build from the repo root; Mobile/ is intentionally out of context.
#
# Local:  docker build -t alive108-api ./server
# Dev:    docker compose up            (compose file at repo root)

# ---------------------------------------------------------------------------
# Stage 1 — build the C++ engine (alive_core, pybind11; docs/plan/08).
# Separate stage so the toolchain (cmake/g++/git ~300 MB) never ships and the
# compile is cached unless server/core sources change.
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS core-builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/core
# Only what CMakeLists.txt consumes — keeps this layer cacheable.
COPY core/CMakeLists.txt core/bindings.cpp ./
COPY core/include ./include
COPY core/src ./src
COPY core/tools ./tools

# FetchContent clones pybind11 v2.13.6 (pinned tag in CMakeLists.txt) — git +
# network needed at build time only. Release/-O3/-fno-fast-math are set by
# the CMakeLists itself; fold_table.inc is generated by tools/gen_fold_table.py.
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --parallel

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm

# Same base for both stages: the .so links against this exact CPython/libc.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # uvicorn/App Runner/ECS all speak 8080 (NLB target group :8080)
    PORT=8080

WORKDIR /app

# requirements.txt is the authoritative dep list (pyproject.toml is a
# manifest; it lacks numpy + h3). pip is what the image has — uv is a
# local-dev tool (uv.lock is gitignored, so there is no lock to sync).
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . ./

# The compiled T1 engine. Placed next to main.py so `import alive_core`
# resolves (server/ dir is on sys.path — same convention as the local
# core/build output). If absent the API still works via alive_core_ref /
# gazetteer — a build problem can never take the API down (docs/plan/08).
COPY --from=core-builder /build/core/build/alive_core*.so ./

# Non-root. Code stays root-owned (immutable to the app user at runtime);
# only the dirs the app actually writes — community.json snapshot, GTFS feed
# cache, worker field snapshots/rollups — are owned by `alive`. chown without
# -R touches dir inodes only, so no duplicate data layer.
RUN groupadd --gid 10001 alive \
    && useradd --uid 10001 --gid alive --no-create-home \
        --home-dir /app --shell /usr/sbin/nologin alive \
    && mkdir -p data/field/snapshots data/field/daily data/field/validation \
        data/gtfs \
    && chown alive:alive data data/field data/field/snapshots \
        data/field/daily data/field/validation data/gtfs
USER alive

# Bake a sha with --build-arg BUILD_SHA=$(git rev-parse --short HEAD);
# ECS also injects it at runtime. Empty stays falsy -> health.py falls back.
ARG BUILD_SHA=""
ENV BUILD_SHA=${BUILD_SHA}

EXPOSE 8080

# No curl in slim — probe with the interpreter that serves the app.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8080')+'/health',timeout=4)"]

# exec-form via sh so $PORT is honored and uvicorn still ends up as PID 1.
CMD ["sh", "-c", "exec python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
