    "/shift": {
      "get": {
        "description": "Occupational dose: what a driver/rider actually inhales across a\nwork shift. For every shift hour, concentration = live field (hour 0)\nor decade-typical median scaled by today's live-vs-typical delta.\nvs_desk = same hours at an indoor/desk exposure basis (~35% ambient,\nrest ventilation) \u2014 the avoidable gap a gig driver pays daily.",
        "operationId": "shift_shift_get",
        "parameters": [
          {
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "title": "Lon",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": 8.0,
              "title": "Hours",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "start_hour",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Hour"
            }
          },
          {
            "in": "query",
            "name": "vehicle",
            "required": false,
            "schema": {
              "default": "driving_two_wheeler",
